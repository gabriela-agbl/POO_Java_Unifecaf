<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.1">

    <persistence-unit name="lojaPU"
                      transaction-type="RESOURCE_LOCAL">

        <class>br.gabi.loja.model.Produto</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.h2.Driver"/>

            <!--
                Banco em ARQUIVO (pasta ./dados): os produtos continuam salvos
                depois que o programa fecha.
                Para usar banco só em memória (como na aula), troque por:
                jdbc:h2:mem:loja;DB_CLOSE_DELAY=-1  e hbm2ddl.auto por "create"
            -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:file:./dados/loja"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="sa"/>

            <property name="jakarta.persistence.jdbc.password"
                      value=""/>

            <!-- update: cria/ajusta a tabela sem apagar os dados existentes -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <!-- Deixe "true" para mostrar o SQL gerado (útil para demonstrar ao professor) -->
            <property name="hibernate.show_sql"
                      value="false"/>
        </properties>
    </persistence-unit>
</persistence>
